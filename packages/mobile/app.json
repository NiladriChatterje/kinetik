{
  "expo": {
    "name": "Kinetik",
    "slug": "kinetik",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "scheme": "kinetik",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kinetik.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Kinetik needs camera access for profile photos and liveness verification.",
        "NSLocationWhenInUseUsageDescription": "Kinetik uses your location to find matches nearby.",
        "NSPhotoLibraryUsageDescription": "Kinetik needs photo library access to upload profile photos.",
        "NSMicrophoneUsageDescription": "Kinetik needs microphone access for voice notes and calls.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "LSApplicationQueriesSchemes": ["tez", "phonepe", "paytmmp"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/adaptive-icon.png",
        "backgroundColor": "#0A0A0F"
      },
      "package": "com.kinetik.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "POST_NOTIFICATIONS",
        "ACCESS_NETWORK_STATE",
        "INTERNET",
        "MODIFY_AUDIO_SETTINGS",
        "SYSTEM_ALERT_WINDOW",
        "WAKE_LOCK",
        "BLUETOOTH"
      ]
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0F"
        }
      ],
      "expo-location",
      "expo-camera",
      "expo-document-picker",
      "expo-image-picker",
      "expo-secure-store",
      "expo-font",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "color": "#000000"
        }
      ],
      "expo-audio",
      "@livekit/react-native-expo-plugin",
      "expo-asset",
      "react-native-fast-tflite"
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "extra": {
      "apiUrl": "http://192.168.31.144:8080",
      "wsUrl": "http://192.168.31.144:8080",
      "productionPose": false
    }
  }
}
