{
  "expo": {
    "name": "Kinetik",
    "slug": "kinetik",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "scheme": "kinetik",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kinetik.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Kinetik needs camera access for profile photos and to match your selfie against them.",
        "NSLocationWhenInUseUsageDescription": "Kinetik uses your location to find matches nearby.",
        "NSPhotoLibraryUsageDescription": "Kinetik needs photo library access to upload profile photos.",
        "NSMicrophoneUsageDescription": "Kinetik needs microphone access for voice notes.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "LSApplicationQueriesSchemes": [
          "tez",
          "phonepe",
          "paytmmp"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/adaptive-icon.png",
        "backgroundColor": "#0A0A0F"
      },
      "package": "com.kinetik.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS",
        "ACCESS_NETWORK_STATE",
        "INTERNET",
        "MODIFY_AUDIO_SETTINGS",
        "WAKE_LOCK"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_PHONE_STATE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "versionCode": 18
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0F"
        }
      ],
      "expo-location",
      [
        "expo-camera",
        {
          "barcodeScannerEnabled": false
        }
      ],
      "expo-document-picker",
      "expo-image-picker",
      "expo-secure-store",
      "expo-font",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "color": "#000000"
        }
      ],
      "expo-audio",
      "expo-asset",
      "./plugins/withoutForegroundServices.js",
      "react-native-fast-tflite"
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "extra": {
      "appEnv": "development",
      "apiUrl": "http://192.168.31.144:8080",
      "wsUrl": "http://192.168.31.144:8080",
      "eas": {
        "projectId": "a35c2c14-a58c-4e3d-9bf3-7e366237115e"
      }
    },
    "owner": "niladrichatterjee"
  }
}
