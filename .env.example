# PostgreSQL
POSTGRES_USER=kinetik
POSTGRES_PASSWORD=kinetik_dev_2024
POSTGRES_DB=kinetik
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=kinetik_redis_2024

# Milvus Vector DB
MILVUS_HOST=localhost
MILVUS_PORT=19530

# LiveKit WebRTC
LIVEKIT_HOST=localhost:7880
LIVEKIT_API_KEY=kinetik_livekit_key
LIVEKIT_API_SECRET=kinetik_livekit_secret_2024

# JWT
JWT_SECRET=super-secret-jwt-key-change-in-production-2024
JWT_EXPIRES_IN=7d

# Google Pay (recurring / UPI Autopay mandate)
# TEST shows the Google Pay sheet with test cards; switch to PRODUCTION after
# registering the app in the Google Pay & Wallet Console.
GOOGLE_PAY_ENVIRONMENT=TEST
GOOGLE_PAY_MERCHANT_ID=BCR2DN4Txxxxxxxx
GOOGLE_PAY_MERCHANT_NAME=Kinetik
# PSP used for PAYMENT_GATEWAY tokenization (e.g. "example" in TEST mode)
GOOGLE_PAY_GATEWAY=example
GOOGLE_PAY_GATEWAY_MERCHANT_ID=exampleGatewayMerchantId
GOOGLE_PAY_COUNTRY_CODE=IN
# HMAC secret for the payments webhook (/api/v1/webhooks/payments), shared
# with the PSP. When set, payloads are signature-verified; leave empty only in dev.
PAYMENT_WEBHOOK_SECRET=

# Services
API_CORE_PORT=3001
REALTIME_PORT=3002

# Mobile App (Expo) — see packages/mobile/src/config.ts
# Set these in app.json → "expo" → "extra" or via EXPO_PUBLIC_* env vars in app.config.ts
# APP_API_URL=http://localhost:3001
# APP_WS_URL=http://localhost:3002

# Environment
NODE_ENV=development
