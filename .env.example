# PostgreSQL
POSTGRES_USER=kinetik
POSTGRES_PASSWORD=kinetik_dev_2024
POSTGRES_DB=kinetik
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis — cache, Socket.IO adapter, presence
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=kinetik_redis_2024

# Redis — dedicated pub/sub event bus (a second local container in dev; point
# it at the same managed instance in production, the key namespaces never collide)
REDIS_EVENTS_HOST=localhost
REDIS_EVENTS_PORT=6380
REDIS_EVENTS_PASSWORD=kinetik_events_2024

# Cloud Redis (Layerbase) — used by api-core and realtime for the event bus,
# Socket.IO adapter, and caching. TLS with SNI.
REDIS_LAYERBASE_URL=rediss://default:password@your-instance.cloud.layerbase.dev:6379
REDIS_LAYERBASE_HOST=your-instance.cloud.layerbase.dev

# Cloud Redis (Aiven Valkey) — used by api-core for rate limiting. TLS with SNI.
REDIS_AIVEN_URL=rediss://default:password@your-instance.aivencloud.com:19121
REDIS_AIVEN_HOST=your-instance.aivencloud.com

# Milvus Vector DB
MILVUS_HOST=localhost
MILVUS_PORT=19530

# JWT
JWT_SECRET=super-secret-jwt-key-change-in-production-2024
JWT_EXPIRES_IN=7d

# Google Play Billing (subscriptions)
# Google is the merchant of record — it shows the purchase sheet, holds the UPI
# Autopay mandate, charges monthly, retries failures and pays out. There is no
# PSP; nothing here charges anyone. The server only verifies purchase tokens
# against the Play Developer API and acknowledges them.
#
# Must match the Play Console listing and the app's Android package name.
GOOGLE_PLAY_PACKAGE_NAME=com.kinetik.app
# Subscription product id from Play Console → Monetise → Subscriptions.
GOOGLE_PLAY_SUBSCRIPTION_PRODUCT_ID=kinetik_premium_monthly
# Service-account key with "View financial data" + "Manage orders and
# subscriptions", from Play Console → Setup → API access. Supply ONE of these:
# the whole JSON on a single line, or a path to the mounted key file.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=
# Shared secret appended to the Pub/Sub push URL for real-time developer
# notifications: https://<your-api-domain>/api/v1/webhooks/play?secret=…
# Without it the endpoint refuses every notification. openssl rand -hex 32
GOOGLE_PLAY_RTDN_SECRET=

# Object storage (S3-compatible) — MinIO locally, Cloudflare R2 / S3 in production.
# MINIO_ENDPOINT is the HOST ONLY — no https:// prefix; the code adds the scheme
# itself based on MINIO_USE_SSL, and doubling it breaks every upload.
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=kinetik-photos
MINIO_USE_SSL=false
# S3 region. MinIO ignores it, Cloudflare R2 wants "auto".
MINIO_REGION=us-east-1
# Where the app tells clients to fetch photos from. "/uploads/" serves them
# through nginx; a remote bucket needs its absolute public URL.
MINIO_PUBLIC_URL=/uploads/
# Root credentials for the local minio container. MINIO_ACCESS_KEY/SECRET_KEY
# fall back to these when unset — a remote bucket needs its own key pair.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
#
# Cloudflare R2 instead — see FREE_HOSTING_GUIDE.md §5:
# MINIO_ENDPOINT=<account-id>.r2.cloudflarestorage.com
# MINIO_ACCESS_KEY=<r2-access-key-id>
# MINIO_SECRET_KEY=<r2-secret>
# MINIO_USE_SSL=true
# MINIO_REGION=auto
# MINIO_PUBLIC_URL=https://pub-<hash>.r2.dev/

# Message + chat-media encryption (AES-256-GCM, any string).
# ⚠️ Changing this makes every already-stored message and media file unreadable.
MESSAGE_ENCRYPTION_KEY=kinetik_msg_enc_key_2024_dev

# Reverse geocoding (Geoapify — 3,000 requests/day free)
GEOAPIFY_API=

# Email one-time passcodes (Brevo — 300 emails/day free, hard-stops at the cap).
# BREVO_SENDER_EMAIL must be a sender verified in the Brevo dashboard, on a
# domain with SPF + DKIM published, or Gmail files the codes under spam.
# Leave blank to only log OTPs (the code is then fixed to 123456 for local testing).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Kinetik
# "true" skips Brevo even when the key above is set. Blank means Brevo is used
# whenever it is configured.
EMAIL_DISABLED=

# SMS one-time passcodes (Twilio). Legacy phone-login path; leave blank to only log OTPs.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# "true" skips Twilio even when the credentials above are set. Blank means
# Twilio is used whenever it is configured.
SMS_DISABLED=

# Expo push notifications. Optional — sends work unauthenticated too.
EXPO_ACCESS_TOKEN=

# KYC document face matching (pose-service). Selfie verification runs on-device,
# so this is optional. UNSET means localhost dev; an explicit EMPTY value means
# "not deployed" and hides the action in the app. The two are NOT the same.
# POSE_SERVICE_URL=

# Services
API_CORE_PORT=3001
REALTIME_PORT=3002

# Mobile App (Expo) — see packages/mobile/src/config.ts
# Set these in app.json → "expo" → "extra" or via EXPO_PUBLIC_* env vars in app.config.ts
# APP_API_URL=http://localhost:3001
# APP_WS_URL=http://localhost:3002

# Environment
NODE_ENV=development
