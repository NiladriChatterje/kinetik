google-cloud-config-json

# Deployment secrets (Play service-account key etc.), never committed
secrets/

# Native build output under the committed Expo android/ project. Git already
# ignores these via packages/mobile/android/.gitignore, but the EAS CLI's
# archive step does not apply that nested "build/" rule to subfolders, so a
# local gradle run would otherwise upload android/app/build (with a cached
# autolinking file full of Windows paths) and break the cloud build.
packages/mobile/android/build/
packages/mobile/android/app/build/
packages/mobile/android/.gradle/
packages/mobile/android/app/.cxx/
packages/mobile/android/local.properties
packages/mobile/android/app/src/main/assets/ggml-hexagon/

# Play upload key, downloaded with eas credentials for local release builds.
# Holds the keystore and its passwords: never commit it or let the EAS CLI
# archive it (that step reads this root file, see the note above).
packages/mobile/credentials.json
packages/mobile/credentials/
*.jks
